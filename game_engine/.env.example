# Get yours from https://dashboard.sarvam.ai (5,000 free credits for buildathon participants)
SARVAM_API_KEY=your_key_here

# Live voice. The same LiveKit project the NPC worker (../agent.py) registers
# with, from https://cloud.livekit.io. Without these, conversations fall back to
# push-to-talk over /api/stt, /api/talk and /api/speak.
LIVEKIT_URL=wss://your-project-xxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_TTS_MODEL=bulbul:v3
