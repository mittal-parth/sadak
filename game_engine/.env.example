# Get yours from https://dashboard.sarvam.ai (5,000 free credits for buildathon participants)
SARVAM_API_KEY=your_key_here

# Optional: override streaming STT WebSocket URL (defaults to same-origin /api/stt/ws)
# NEXT_PUBLIC_STT_WS_URL=wss://playsadak.vercel.app/api/stt/ws

# Supabase auth (Google OAuth + magic link). Create a project at https://supabase.com
# Publishable key from Dashboard → Settings → API Keys (sb_publishable_…)
# https://supabase.com/docs/guides/getting-started/api-keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Secret key — local scripts only (npm run warm-tts-cache). sb_secret_… from Settings → API Keys.
# Never expose to the browser or Vercel.
# https://supabase.com/docs/guides/getting-started/api-keys
# SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Live voice. The same LiveKit project the NPC worker (../agent.py) registers
# with, from https://cloud.livekit.io. Without these, conversations fall back to
# push-to-talk over /api/stt, /api/talk and /api/speak.
LIVEKIT_URL=wss://your-project-xxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Canonical origin for Open Graph / Twitter link previews (no trailing slash)
# NEXT_PUBLIC_SITE_URL=https://playsadak.vercel.app

# PostHog analytics (EU). Project token from https://eu.posthog.com → Project settings
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional overrides
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_TTS_MODEL=bulbul:v3
